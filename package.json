{
  "name": "zenspec",
  "version": "0.1.0",
  "description": "Human review for agent-written plans: a one-command CLI loop, a browser reviewer with threads and verdicts, and an approval gate.",
  "type": "module",
  "bin": {
    "zenspec": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills/zenspec",
    "plugins",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm test",
    "build": "node --import tsx scripts/build.ts",
    "pretest": "npm run build",
    "start": "node dist/cli.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "lint:fix": "eslint src tests scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "agent",
    "cli",
    "markdown",
    "review",
    "plan",
    "adr",
    "claude-code"
  ],
  "license": "MIT",
  "dependencies": {
    "chokidar": "^6.0.0",
    "katex": "^0.19.1",
    "mdast-util-to-string": "^4.0.0",
    "open": "^11.0.4",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/signals": "^2.11.4",
    "@types/katex": "^0.16.7",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.1",
    "happy-dom": "^21.0.4",
    "mermaid": "^12.2.0",
    "preact": "^11.1.0",
    "prettier": "^3.9.10",
    "puppeteer": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
