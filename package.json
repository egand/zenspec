{
  "name": "zenspec",
  "version": "0.1.0",
  "description": "Minimalist, token-efficient Agent Experience Interface (AXI) and browser reviewer for Markdown & HTML artifacts",
  "type": "module",
  "bin": {
    "zenspec": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills/zenspec",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "build": "node --import tsx scripts/build.ts",
    "start": "node dist/cli.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "lint:fix": "eslint src tests scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "axi",
    "agent",
    "cli",
    "markdown",
    "html",
    "review",
    "collaboration"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chokidar": "^4.0.3",
    "cross-spawn": "^7.0.6",
    "katex": "^0.16.21",
    "marked": "^15.0.7",
    "mermaid": "^11.4.1",
    "open": "^10.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.5.2",
    "puppeteer": "^25.9.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7"
  }
}
